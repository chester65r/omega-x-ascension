
# Android build artifacts
android/.gradle/
android/app/build/
android/app/src/main/assets/
android/local.properties
*.apk

# Archives
*.tar.gz

# Private Android signing material — never commit
*.jks
*.keystore
*.p12
*.pfx

# Real environment files hold secrets - generate them with scripts/generate_env.py, never commit.
# (.env.example, and the already-tracked .env.base44-defaults, are unaffected.)
.env
.env.local
.env.*.local

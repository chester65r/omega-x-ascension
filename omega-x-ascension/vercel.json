{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "https://omega-x-ascension-api.onrender.com/"
    },
    {
      "source": "/:path*",
      "destination": "https://omega-x-ascension-api.onrender.com/:path*"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}

OMEGA_ENV=development
POSTGRES_PASSWORD=set-a-strong-owner-password
OMEGA_APP_PASSWORD=set-a-different-strong-app-password
OMEGA_WORKER_PASSWORD=set-a-third-strong-worker-password
OMEGA_CHECKPOINT_PASSWORD=set-a-fourth-strong-checkpoint-password
REDIS_PASSWORD=set-a-strong-redis-password
OMEGA_MIGRATION_DATABASE_URL=postgresql+psycopg://omega:${POSTGRES_PASSWORD}@postgres:5432/omega
OMEGA_DATABASE_URL=postgresql+asyncpg://omega_app:${OMEGA_APP_PASSWORD}@postgres:5432/omega
OMEGA_WORKER_DATABASE_URL=postgresql+asyncpg://omega_worker:${OMEGA_WORKER_PASSWORD}@postgres:5432/omega
OMEGA_CHECKPOINT_DATABASE_URL=postgresql://omega_checkpoint:${OMEGA_CHECKPOINT_PASSWORD}@postgres:5432/omega
OMEGA_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
OMEGA_JWT_SECRET=set-at-least-32-random-characters-here
OMEGA_SANDBOX_TOKEN=set-a-separate-random-32-character-token
OMEGA_SANDBOX_URL=http://sandbox:8090
OMEGA_JWT_ISSUER=omega-x
OMEGA_JWT_AUDIENCE=omega-x-api
OMEGA_JWT_ALGORITHM=HS256
OMEGA_MODEL_PROVIDERS=[]
# Optional flagship model; store the real key only in a deployment secret manager.
# OMEGA_OPENAI_API_KEY=
OMEGA_OPENAI_MODEL=gpt-6-astra
OMEGA_OPENAI_BASE_URL=https://api.openai.com/v1
OMEGA_OPENAI_PRIORITY=100
# Optional: create a narrowly scoped Hugging Face inference token and keep it secret.
# Free accounts receive limited monthly credits; this is not unlimited free hosting.
# OMEGA_HF_INFERENCE_TOKEN=hf_your_token_here
# OMEGA_HF_INFERENCE_MODEL=Qwen/Qwen3-4B:featherless-ai
# OMEGA_HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1
OMEGA_LOG_LEVEL=INFO
OMEGA_ENABLE_COMPUTER_EXECUTION=false
OMEGA_ENABLE_COMPUTER_FILES=true
LANGGRAPH_STRICT_MSGPACK=true

# Webhooks and Real-Time Notifications
# OMEGA_GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
# OMEGA_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# OMEGA_TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# OMEGA_TELEGRAM_CHAT_ID=-1001234567890
OMEGA_NOTIFICATIONS_ENABLED=true

# API service configuration only. Never put real secrets in source control.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./omega.db
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
AUTO_CREATE_SCHEMA=true
ACCESS_TOKEN_TTL_SECONDS=3600
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_API_KEY=
# Set an exact model ID confirmed for this provider account before enabling a key.
AI_MODEL=
PROVIDER_TIMEOUT_SECONDS=45
